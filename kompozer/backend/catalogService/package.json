{
  "name": "@kompozer/catalog-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":           "ts-node-dev --respawn --transpile-only src/index.ts",
    "build":         "tsc",
    "start":         "node dist/index.js",
    "seed":          "ts-node --transpile-only src/seed.ts",
    "test":          "jest --runInBand",
    "test:watch":    "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "cors":      "^2.8.5",
    "express":   "^4.18.2",
    "ioredis":   "^5.3.2",
    "mongoose":  "^8.4.1",
    "pino":      "^10.3.1",
    "pino-http": "^11.0.0",
    "uuid":      "^9.0.1",
    "zod":       "^4.4.3"
  },
  "devDependencies": {
    "@types/cors":       "^2.8.17",
    "@types/express":    "^4.17.21",
    "@types/jest":       "^29.5.12",
    "@types/uuid":       "^9.0.8",
    "jest":              "^29.7.0",
    "pino-pretty":       "^13.1.3",
    "supertest":         "^7.0.0",
    "@types/supertest":  "^6.0.2",
    "ts-jest":           "^29.1.4",
    "ts-node-dev":       "^2.0.0",
    "typescript":        "^5.4.5"
  }
}
