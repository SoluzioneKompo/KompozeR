# Shared
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme
JWT_SECRET=changeme
REDIS_URL=redis://redis:6379

# Per-service MongoDB URIs (container Mongo locali, uno per servizio — vedi docker-compose.prod.yml)
AUTH_MONGO_URI=mongodb://root:changeme@mongo-auth:27017/authdb?authSource=admin
CART_MONGO_URI=mongodb://root:changeme@mongo-cart:27017/cartdb?authSource=admin
CATALOG_MONGO_URI=mongodb://root:changeme@mongo-catalog:27017/catalogdb?authSource=admin
ORDER_MONGO_URI=mongodb://root:changeme@mongo-order:27017/orderdb?authSource=admin
PAYMENT_MONGO_URI=mongodb://root:changeme@mongo-payment:27017/paymentdb?authSource=admin
NOTIFICATION_MONGO_URI=mongodb://root:changeme@mongo-notification:27017/notificationdb?authSource=admin
REPORTING_MONGO_URI=mongodb://root:changeme@mongo-reporting:27017/reportingdb?authSource=admin

# Consistenza CAD (replica set locale mongo-cad-1/2/arb, vedi docker-compose.prod.yml)
CAD_WRITE_CONCERN=majority
CAD_READ_CONCERN=majority
CAD_READ_PREFERENCE=primaryPreferred
CAD_CHECKPOINT_INTERVAL_MS=10000

# Service ports
GATEWAY_PORT=3000
AUTH_PORT=3001
CAD_PORT=3002
CART_PORT=3003
CATALOG_PORT=3004
NOTIFICATION_PORT=3006
REPORTING_PORT=3007
ORDER_PORT=3008
PAYMENT_PORT=3009
