{
  "name": "kompozer-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Workspace scripts for baseline services and e2e suites.",
  "scripts": {
    "test:auth": "npm --prefix backend/authenticationService test -- --runInBand",
    "test:catalog": "npm --prefix backend/catalogService test -- --runInBand",
    "test:cart": "npm --prefix backend/cartService test -- --runInBand",
    "test:order": "npm --prefix backend/orderService test -- --runInBand",
    "test:payment": "npm --prefix backend/paymentService test -- --runInBand",
    "test:gateway": "npm --prefix backend/apiGateway test -- --runInBand",
    "test:cad": "npm --prefix backend/cadService test -- --runInBand",
    "test:notification": "npm --prefix backend/notificationService test -- --runInBand",
    "test:reporting": "npm --prefix backend/reportingService test -- --runInBand",
    "test:backend": "npm run test:auth && npm run test:catalog && npm run test:cart && npm run test:order && npm run test:payment && npm run test:gateway && npm run test:cad && npm run test:notification && npm run test:reporting",
    "test:e2e": "npm --prefix e2e test -- --runInBand",
    "test:baseline": "npm run test:backend && npm run test:e2e",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  }
}
