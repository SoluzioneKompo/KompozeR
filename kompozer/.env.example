# Shared
JWT_SECRET=changeme
REDIS_URL=redis://redis:6379

# MongoDB Atlas — un unico cluster M0 free, un database per servizio.
# Prendi user/password/cluster-host da Atlas → Database → Connect → Drivers,
# poi sostituisci <user>, <password> e <cluster-host> in tutte le righe sotto
# (stesso cluster, cambia solo il nome del db nel path).
AUTH_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/authdb?retryWrites=true&w=majority
CAD_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/caddb?retryWrites=true&w=majority
CART_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/cartdb?retryWrites=true&w=majority
CATALOG_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/catalogdb?retryWrites=true&w=majority
ORDER_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/orderdb?retryWrites=true&w=majority
PAYMENT_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/paymentdb?retryWrites=true&w=majority
NOTIFICATION_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/notificationdb?retryWrites=true&w=majority
REPORTING_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/reportingdb?retryWrites=true&w=majority

# Consistenza CAD (Atlas è già un replica set gestito, questi valori si applicano lo stesso)
CAD_WRITE_CONCERN=majority
CAD_READ_CONCERN=majority
CAD_READ_PREFERENCE=primaryPreferred
CAD_CHECKPOINT_INTERVAL_MS=10000

# Service ports
GATEWAY_PORT=3000
AUTH_PORT=3001
CAD_PORT=3002
CART_PORT=3003
CATALOG_PORT=3004
NOTIFICATION_PORT=3006
REPORTING_PORT=3007
ORDER_PORT=3008
PAYMENT_PORT=3009
